<resources>
    <style name="Theme.ClimaHoy" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>

        <!-- Fondo y texto del cuerpo -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:textColor">@color/colorOnBackground</item>

        <!-- ActionBar con tu morado -->
        <item name="android:actionBarStyle">@style/ClimaHoy.ActionBar</item>
    </style>

    <style name="ClimaHoy.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/colorPrimary</item>
        <item name="titleTextStyle">@style/ClimaHoy.ActionBar.TitleText</item>
    </style>

    <style name="ClimaHoy.ActionBar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

